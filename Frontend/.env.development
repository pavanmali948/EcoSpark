# Local backend API (Vite proxies /api → http://localhost:8080)
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=/api

# Optional: Google Maps (if omitted, app uses OpenStreetMap — no key needed)
# Get a key: https://console.cloud.google.com/ → enable Maps JavaScript + Directions + Distance Matrix APIs
# VITE_GOOGLE_MAPS_API_KEY=your_key_here
